+-#define next2 "cur"
+-        FILTER
+-#undef prev2
+-#undef next2
+-    } else {
+-#define prev2 "cur"
+-#define next2 "next"
+-        FILTER
+-#undef prev2
+-#undef next2
+-    }
+-}
