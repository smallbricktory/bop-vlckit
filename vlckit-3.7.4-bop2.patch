+ modules/video_filter/deinterlace/algo_yadif.h |  94 ------
+ .../video_filter/deinterlace/deinterlace.c    |   4 -
+ .../video_filter/deinterlace/deinterlace.h    |   5 +-
+ modules/video_filter/deinterlace/yadif.h      | 153 ----------
+ .../video_filter/deinterlace/yadif_template.h | 282 ------------------
+ src/libvlc-module.c                           |   4 +-
+ src/video_output/interlacing.c                |   2 -
+ 10 files changed, 4 insertions(+), 745 deletions(-)
+ delete mode 100644 modules/video_filter/deinterlace/algo_yadif.c
+ delete mode 100644 modules/video_filter/deinterlace/algo_yadif.h
+ delete mode 100644 modules/video_filter/deinterlace/yadif.h
+ delete mode 100644 modules/video_filter/deinterlace/yadif_template.h
+
