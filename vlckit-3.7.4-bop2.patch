From b1304c04917420803016a0b51a23ba2e4c4725b7 Mon Sep 17 00:00:00 2001
From: Small Bricktory <studio@smallbricktory.com>
Date: Wed, 28 Oct 2026 12:53:51 -0700
Subject: [PATCH] MobileVLCKit 3.7.4-bop2: remove GPL-licensed code, iOS minimum 26.0

- contrib bootstrap --disable-zvbi and VLC configure --disable-zvbi
  (libzvbi has GPL-2-only files; teletext goes through telx)
- blacklist the GPL-2+ modules rotate, vod_rtsp, stream_out_rtp,
  syslog, mono, dolby_surround_decoder, dummy (control)
- VLC patch 0047: remove the GPL-2+ yadif deinterlace modes
- VLC patch 0048: FFmpeg contrib without the GPL-2+ aarch64 AC-3 DSP
- SDK_MIN 26.0
- ASMFLAGS exported so CMake-built assembly objects (mpg123) also target iOS 26.0
- iOS simulator slice arm64 only (no x86_64)
---
 buildMobileVLCKit.sh                          |  19 +-
 ...ve-the-GPL-2-yadif-and-yadif2x-modes.patch | 884 ++++++++++++++++++
 ...o-not-build-the-GPL-2-aarch64-AC-3-D.patch |  72 ++
 3 files changed, 968 insertions(+), 7 deletions(-)
 create mode 100644 libvlc/patches/0047-deinterlace-remove-the-GPL-2-yadif-and-yadif2x-modes.patch
 create mode 100644 libvlc/patches/0048-contrib-ffmpeg-do-not-build-the-GPL-2-aarch64-AC-3-D.patch

diff --git a/buildMobileVLCKit.sh b/buildMobileVLCKit.sh
index 3e274a0..1e0eb1b 100755
--- a/buildMobileVLCKit.sh
+++ b/buildMobileVLCKit.sh
@@ -9,7 +9,7 @@ BUILD_SIMULATOR=yes
 BUILD_DYNAMIC_FRAMEWORK=no
 BUILD_ARCH=`uname -m | cut -d. -f1`
 SDK_VERSION=`xcrun --sdk iphoneos --show-sdk-version`
-SDK_MIN=9.0
+SDK_MIN=26.0
 VERBOSE=no
 DEBUG=no
 CONFIGURATION="Release"
@@ -237,7 +237,7 @@ buildxcodeproj()
         fi
         if [ "$IOS" = "yes" ]; then
             if [ "$PLATFORM" = "iphonesimulator" ]; then
-                architectures="arm64 x86_64"
+                architectures="arm64"
             else
                 if [ "$INCLUDE_32BIT" = "yes" ]; then
                     architectures="armv7 armv7s arm64"
@@ -437,6 +437,7 @@ buildLibVLC() {
     export CPPFLAGS="${EXTRA_CFLAGS}"
     export CXXFLAGS="${EXTRA_CFLAGS}"
     export OBJCFLAGS="${EXTRA_CFLAGS}"
+    export ASMFLAGS="${EXTRA_CFLAGS}"
     export LDFLAGS="${EXTRA_LDFLAGS}"
 
     spushd ${VLCROOT}/contrib
@@ -554,7 +555,7 @@ buildLibVLC() {
         --disable-sdl \
         --disable-SDL_image \
         --disable-iconv \
-        --enable-zvbi \
+        --disable-zvbi \
         --disable-kate \
         --disable-caca \
         --disable-gettext \
@@ -642,7 +643,7 @@ buildLibVLC() {
     fi
 
     if [ "$SCARY" = "yes" ]; then
-        SCARYFLAG="--enable-dvbpsi --enable-avcodec"
+        SCARYFLAG="--enable-dvbpsi --enable-avcodec --disable-zvbi"
     else
         SCARYFLAG="--disable-dca --disable-dvbpsi --disable-avcodec --disable-avformat --disable-zvbi --enable-vpx"
     fi
@@ -793,6 +794,13 @@ buildLibVLC() {
     fingerprinter
     output_udp
     output_livehttp
+    librotate_plugin
+    libvod_rtsp_plugin
+    libstream_out_rtp_plugin
+    libsyslog_plugin
+    libmono_plugin
+    libdolby_surround_decoder_plugin
+    libdummy_plugin
     "
 
     if [ "$SCARY" = "no" ]; then
@@ -880,7 +888,6 @@ buildMobileKit() {
             fi
             if [ "$IOS" = "yes" ]; then
                 if [ "$PLATFORM" = "iphonesimulator" ]; then
-                    buildLibVLC "x86_64" "Simulator"
                     buildLibVLC "aarch64" "Simulator"
                 else
                     if [ "$INCLUDE_32BIT" = "yes" ]; then
@@ -951,8 +958,6 @@ collect_symbols_and_libraries() {
     arch="aarch64"
     if [ "$FARCH" != "all" ];then
         arch="$FARCH"
-    elif [ "$BUILD_SIMULATOR" = "yes" ]; then
-        arch="x86_64"
     fi
 
     actual_arch=`get_actual_arch $arch`
