+-             [cur]  "r"(cur),\
+-             [next] "r"(next),\
+-             [prefs]"r"((x86_reg)prefs),\
+-             [mrefs]"r"((x86_reg)mrefs),\
+-             MANGLEVARIABLES\
+-             [tmp]  "r"(tmp)\
+-        );\
+-        __asm__ volatile(MOV" "MM"1, %0" :"=m"(*dst));\
