++-#elif ARCH_ARM
+++#if ARCH_ARM
++     ff_ac3dsp_init_arm(c);
++ #elif ARCH_X86 && HAVE_X86ASM
++     ff_ac3dsp_init_x86(c);
++--- a/libavcodec/aarch64/Makefile	2026-10-28 11:34:41
+++++ b/libavcodec/aarch64/Makefile	2026-10-28 11:34:41
